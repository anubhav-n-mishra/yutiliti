{
  "name": "yuitility",
  "version": "1.0.0",
  "description": "Client-side, privacy-first web utility toolkit featuring 132+ instant-use in-browser tools with zero server data uploads.",
  "author": "Anubhav Mishra",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/anubhav-n-mishra/yuitility.git"
  },
  "homepage": "https://www.yuitility.app",
  "bugs": {
    "url": "https://github.com/anubhav-n-mishra/yuitility/issues"
  },
  "keywords": [
    "utility",
    "developer-tools",
    "privacy-first",
    "client-side",
    "in-browser",
    "wasm",
    "nextjs",
    "react",
    "calculators",
    "pdf-tools",
    "image-tools"
  ],
  "type": "module",
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run indexnow:test && npm run seo:audit",
    "test:unit": "tsx scripts/indexnow.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "seo:audit": "node scripts/seo-audit.mjs",
    "prebuild": "node scripts/seo-audit.mjs",
    "indexnow:sync": "tsx scripts/indexnow-sync.ts",
    "indexnow:test": "tsx scripts/indexnow.test.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@google/genai": "^2.4.0",
    "@imgly/background-removal": "^1.7.0",
    "@types/nodemailer": "^8.0.1",
    "@types/three": "^0.185.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.43.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
